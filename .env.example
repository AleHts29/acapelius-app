# Copiar a .env y ajustar. `make dev` carga este archivo automaticamente.

# En produccion el server escucha en 8080. En desarrollo usa 8081 porque 8080
# es el puerto que mas se pisa con otros proyectos; el proxy de Vite lo lee de
# aca, asi que cambiarlo alcanza.
PORT=8081
BASE_URL=http://localhost:5173

# Postgres local levantado por docker-compose.yml
DATABASE_URL=postgres://acapelius:acapelius@localhost:5433/acapelius?sslmode=disable

# Firma HMAC de los QR y cifrado de sesiones. Minimo 32 bytes.
# Generar con: openssl rand -hex 32
SERVER_SECRET=dev-only-secret-change-me-0123456789abcdef

# 'log' escribe los emails a stdout. 'resend' usa la API de Resend.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM="Acapelius <entradas@example.com>"

TZ=America/Argentina/Buenos_Aires

# Corre las migraciones pendientes al arrancar el server.
AUTO_MIGRATE=true

# Usados solo por `make seed` para crear el primer admin.
SEED_ADMIN_NAME=Eli
SEED_ADMIN_EMAIL=eli@acapelius.local
SEED_ADMIN_PASSWORD=acapelius
